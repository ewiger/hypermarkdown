{
  "name": "@hypermarkdown/core",
  "version": "0.2.0",
  "description": "Parser, resolver, and renderer for HyperMarkDown (HMD-0020).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ewiger/hypermarkdown.git",
    "directory": "tools/hmd-ts-core"
  },
  "bugs": {
    "url": "https://github.com/ewiger/hypermarkdown/issues"
  },
  "homepage": "https://hypermarkdown.org/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
