{
  "name": "hmd",
  "displayName": "HyperMarkDown",
  "description": "An editor for HyperMarkDown (.hmd) knowledge bases: real-time preview, embeds, a graph of the vault, HQL cells, and diagnostics.",
  "version": "0.7.0",
  "license": "MIT",
  "icon": "media/logo.png",
  "publisher": "hypermarkdown",
  "galleryBanner": {
    "color": "#1c1c1c",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/docs-hypermarkdown.org-ffb300",
      "href": "https://hypermarkdown.org/tools/vscode/",
      "description": "Documentation at hypermarkdown.org"
    },
    {
      "url": "https://github.com/ewiger/hypermarkdown/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/ewiger/hypermarkdown/actions/workflows/ci.yml",
      "description": "CI status"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ewiger/hypermarkdown.git",
    "directory": "tools/hmd-vsc-ext"
  },
  "bugs": {
    "url": "https://github.com/ewiger/hypermarkdown/issues"
  },
  "homepage": "https://hypermarkdown.org/tools/vscode/",
  "qna": "https://github.com/ewiger/hypermarkdown/issues",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Notebooks"
  ],
  "keywords": [
    "hypermarkdown",
    "hmd",
    "wiki",
    "wikilinks",
    "knowledge base",
    "hql"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Indexing and preview are read-only and run in untrusted workspaces, and a card's saved HQL outputs are shown there. Running an HQL cell, creating a missing card, and initializing a vault require trust. The language server starts only in a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Cards render from the workspace file system. D2 diagrams need a local `d2` binary, so they show their source instead, and HQL cells show their saved output and do not run. The language server does not start, so links are coloured by the grammar alone."
    }
  },
  "activationEvents": [
    "workspaceContains:**/*.hmd",
    "workspaceContains:.hmd/config.toml",
    "onWebviewPanel:hyperMarkdown.previewPanel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hmd",
        "aliases": [
          "HyperMarkDown",
          "hmd"
        ],
        "extensions": [
          ".hmd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hql",
        "aliases": [
          "HQL",
          "hql"
        ],
        "extensions": [
          ".hql"
        ],
        "configuration": "./hql.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hmd",
        "scopeName": "source.hmd",
        "path": "./syntaxes/hmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.hql": "hql",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.ini": "ini",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.lua": "lua",
          "meta.embedded.block.makefile": "makefile",
          "meta.embedded.block.perl": "perl",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.vs_net": "vb",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.xsl": "xsl",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.dosbatch": "bat",
          "meta.embedded.block.clojure": "clojure",
          "meta.embedded.block.coffee": "coffeescript",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.diff": "diff",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.groovy": "groovy",
          "meta.embedded.block.pug": "jade",
          "meta.embedded.block.ignore": "ignore",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.jsonc": "jsonc",
          "meta.embedded.block.jsonl": "jsonl",
          "meta.embedded.block.less": "less",
          "meta.embedded.block.objc": "objective-c",
          "meta.embedded.block.swift": "swift",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.perl6": "perl6",
          "meta.embedded.block.powershell": "powershell",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.julia": "julia",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.typescriptreact": "typescriptreact",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.block.fsharp": "fsharp",
          "meta.embedded.block.dart": "dart",
          "meta.embedded.block.handlebars": "handlebars",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.log": "log",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.bibtex": "bibtex",
          "meta.embedded.block.restructuredtext": "restructuredtext"
        }
      },
      {
        "scopeName": "source.hmd.fences",
        "path": "./syntaxes/hmd-fences.tmLanguage.json"
      },
      {
        "language": "hql",
        "scopeName": "source.hql",
        "path": "./syntaxes/hql.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "hyperMarkdown.openPreview",
        "title": "Open Preview in This Column",
        "category": "HyperMarkDown",
        "icon": "media/logo.svg"
      },
      {
        "command": "hyperMarkdown.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "HyperMarkDown",
        "icon": "$(open-preview)"
      },
      {
        "command": "hyperMarkdown.togglePin",
        "title": "Pin Preview to This Card",
        "category": "HyperMarkDown",
        "icon": "$(pin)"
      },
      {
        "command": "hyperMarkdown.createCardFromLink",
        "title": "Create Missing Card",
        "category": "HyperMarkDown"
      },
      {
        "command": "hyperMarkdown.initVault",
        "title": "Initialize Vault",
        "category": "HyperMarkDown",
        "icon": "$(new-folder)"
      },
      {
        "command": "hyperMarkdown.refreshIndex",
        "title": "Rebuild Index",
        "category": "HyperMarkDown",
        "icon": "$(refresh)"
      },
      {
        "command": "hyperMarkdown.runCell",
        "title": "Run HQL Cell",
        "category": "HyperMarkDown",
        "icon": "$(play)"
      },
      {
        "command": "hyperMarkdown.runAllCells",
        "title": "Run All HQL Cells",
        "category": "HyperMarkDown",
        "icon": "$(run-all)"
      },
      {
        "command": "hyperMarkdown.showDiagram",
        "title": "Show Diagram",
        "category": "HyperMarkDown",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hyperMarkdown.openPreview",
          "when": "hyperMarkdown.hasRoot || editorLangId == hmd",
          "group": "navigation@1"
        },
        {
          "command": "hyperMarkdown.togglePin",
          "when": "activeWebviewPanelViewType == hyperMarkdown.previewPanel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "hyperMarkdown.openPreview",
          "when": "hyperMarkdown.hasRoot || editorLangId == hmd"
        },
        {
          "command": "hyperMarkdown.openPreviewToSide",
          "when": "hyperMarkdown.hasRoot || editorLangId == hmd"
        },
        {
          "command": "hyperMarkdown.initVault",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "hyperMarkdown.togglePin",
          "when": "hyperMarkdown.hasRoot"
        },
        {
          "command": "hyperMarkdown.createCardFromLink",
          "when": "editorLangId == hmd"
        },
        {
          "command": "hyperMarkdown.runCell",
          "when": "editorLangId == hmd && isWorkspaceTrusted"
        },
        {
          "command": "hyperMarkdown.runAllCells",
          "when": "editorLangId == hmd && isWorkspaceTrusted"
        },
        {
          "command": "hyperMarkdown.showDiagram",
          "when": "editorLangId == hmd"
        }
      ]
    },
    "configuration": {
      "title": "HyperMarkDown",
      "properties": {
        "hyperMarkdown.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "An explicit namespace root for the workspace folder, relative to it. Vaults are discovered from the card, by walking up to the nearest `.hmd/` directory, and a card with no `.hmd/` above it is not read. Set this to read such cards anyway, from the directory it names; it also wins over the folder's own `.hmd/config.toml`. Empty means no explicit root: run **HyperMarkDown: Initialize Vault** to make the folder a vault instead."
        },
        "hyperMarkdown.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep the preview and the editor scrolled to the same source line."
        },
        "hyperMarkdown.preview.embeds": {
          "type": "string",
          "enum": [
            "expanded",
            "collapsed"
          ],
          "default": "expanded",
          "description": "Whether embed cards start expanded or collapsed."
        },
        "hyperMarkdown.diagram.d2Path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `d2` executable to render diagrams with. Empty uses the `d2` bundled with this build — a pinned [hypermarkdown-toolchain](https://github.com/ewiger/hypermarkdown-toolchain) release, the same binary the documentation site is built with — falling back to `d2` on `PATH`. Set this only to test a different build of d2 deliberately: it takes precedence over the bundled one, and a path that is not an executable is reported rather than silently ignored."
        },
        "hyperMarkdown.diagram.mermaidPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `merman-cli` executable to draw Mermaid diagrams with. Empty uses the `merman-cli` bundled with this build — a pinned [hypermarkdown-toolchain](https://github.com/ewiger/hypermarkdown-toolchain) release, the same binary the documentation site is built with — falling back to `merman-cli` on `PATH`. [merman](https://github.com/latias94/merman) draws Mermaid without a browser. Set this only to test a different build of it deliberately: it takes precedence over the bundled one, and a path that is not an executable is reported rather than silently ignored."
        },
        "hyperMarkdown.hql.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to an `hql` executable to run HQL cells with, overriding the default. Empty uses the `hql` bundled with this build — a pinned [hypermarkdown-toolchain](https://github.com/ewiger/hypermarkdown-toolchain) release, on Linux x64, macOS and Windows — falling back to `hql` on `PATH`. Set this only to run cells with a different build of HQL deliberately. A shell alias is not on `PATH`: point this at the binary itself. A path that is not an executable is reported rather than silently ignored. See [HQL](https://hql-lang.org/)."
        },
        "hyperMarkdown.diagnostics.scope": {
          "type": "string",
          "enum": [
            "open",
            "workspace"
          ],
          "default": "workspace",
          "markdownDescription": "Publish diagnostics for open documents only, or for every card in the index — which means every vault this window has opened a card in. A red link in a card nobody has opened is still a work item."
        },
        "hyperMarkdown.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Start `hmd-lsp`, the HyperMarkDown language server, for `.hmd` files. With it, a link that names no card is coloured as broken, and hover and **Go to Definition** work on links. The preview, the graph, the cells and the diagnostics do not need it. The server never starts in an untrusted or a virtual workspace."
        },
        "hyperMarkdown.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Absolute path to an `hmd-lsp` executable, overriding the default. Empty uses the `hmd-lsp` bundled with this build, falling back to `hmd-lsp` on `PATH`. A path that is not a file is reported rather than silently ignored."
        }
      }
    },
    "semanticTokenModifiers": [
      {
        "id": "unresolved",
        "description": "A reference that names no card."
      },
      {
        "id": "ambiguous",
        "description": "A reference that names more than one card."
      },
      {
        "id": "outside",
        "description": "A reference whose path leaves the namespace."
      },
      {
        "id": "embed",
        "description": "A reference that is an embed, written ![[…]]."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "hmd",
        "scopes": {
          "class": [
            "entity.name.reference.hmd"
          ],
          "property": [
            "entity.other.attribute-name.fragment.hmd"
          ],
          "string": [
            "string.other.link.title.hmd"
          ],
          "class.unresolved": [
            "invalid.illegal.reference.unresolved.hmd"
          ],
          "class.ambiguous": [
            "invalid.illegal.reference.ambiguous.hmd"
          ],
          "class.outside": [
            "invalid.illegal.reference.outside.hmd"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[hmd]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "node ../../scripts/launch-example.mjs cs-alg-sorting",
    "example:sorting": "node ../../scripts/launch-example.mjs cs-alg-sorting",
    "example:small": "node ../../scripts/launch-example.mjs small",
    "example:notebook": "node ../../scripts/launch-example.mjs notebook",
    "example:highlighting": "node ../../scripts/launch-example.mjs highlighting",
    "example:repo": "node ../../scripts/launch-example.mjs repo",
    "example:wiki": "node ../../scripts/launch-example.mjs wiki",
    "package": "npm run build && node ../../scripts/toolchain.mjs --dest tools/hmd-vsc-ext/toolchain && vsce package --no-dependencies",
    "grammar": "node syntaxes/fences.mjs"
  },
  "dependencies": {
    "@hypermarkdown/core": "^0.4.0",
    "cytoscape": "^3.34.3",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
