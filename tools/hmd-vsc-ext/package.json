{
  "name": "hmd",
  "displayName": "HyperMarkDown",
  "description": "Live preview, embeds, backlinks, and diagnostics for HyperMarkDown (.hmd) knowledge bases.",
  "version": "0.2.0",
  "license": "MIT",
  "icon": "media/logo.png",
  "publisher": "hypermarkdown",
  "preview": true,
  "galleryBanner": {
    "color": "#1c1c1c",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/docs-hypermarkdown.org-ffb300",
      "href": "https://hypermarkdown.org/tools/vscode/",
      "description": "Documentation at hypermarkdown.org"
    },
    {
      "url": "https://github.com/ewiger/hypermarkdown/actions/workflows/ci.yml/badge.svg",
      "href": "https://github.com/ewiger/hypermarkdown/actions/workflows/ci.yml",
      "description": "CI status"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ewiger/hypermarkdown.git",
    "directory": "tools/hmd-vsc-ext"
  },
  "bugs": {
    "url": "https://github.com/ewiger/hypermarkdown/issues"
  },
  "homepage": "https://hypermarkdown.org/tools/vscode/",
  "qna": "https://github.com/ewiger/hypermarkdown/issues",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Notebooks"
  ],
  "keywords": [
    "hypermarkdown",
    "hmd",
    "wiki",
    "wikilinks",
    "knowledge base"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Indexing and preview are read-only and run in untrusted workspaces. Creating a missing card requires trust."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Cards render from the workspace file system. D2 diagrams need a local `d2` binary, so they show their source instead."
    }
  },
  "activationEvents": [
    "workspaceContains:**/*.hmd",
    "workspaceContains:.hmd/config.toml",
    "onWebviewPanel:hyperMarkdown.previewPanel"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hmd",
        "aliases": [
          "HyperMarkDown",
          "hmd"
        ],
        "extensions": [
          ".hmd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hmd",
        "scopeName": "source.hmd",
        "path": "./syntaxes/hmd.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.yaml": "yaml"
        }
      }
    ],
    "commands": [
      {
        "command": "hyperMarkdown.openPreview",
        "title": "Open Preview in This Column",
        "category": "HyperMarkDown",
        "icon": "media/logo.svg"
      },
      {
        "command": "hyperMarkdown.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "HyperMarkDown",
        "icon": "$(open-preview)"
      },
      {
        "command": "hyperMarkdown.togglePin",
        "title": "Pin Preview to This Card",
        "category": "HyperMarkDown",
        "icon": "$(pin)"
      },
      {
        "command": "hyperMarkdown.createCardFromLink",
        "title": "Create Missing Card",
        "category": "HyperMarkDown"
      },
      {
        "command": "hyperMarkdown.refreshIndex",
        "title": "Rebuild Index",
        "category": "HyperMarkDown",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "hyperMarkdown.openPreview",
          "when": "hyperMarkdown.hasRoot",
          "group": "navigation@1"
        },
        {
          "command": "hyperMarkdown.togglePin",
          "when": "activeWebviewPanelViewType == hyperMarkdown.previewPanel",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "hyperMarkdown.openPreview",
          "when": "hyperMarkdown.hasRoot"
        },
        {
          "command": "hyperMarkdown.openPreviewToSide",
          "when": "hyperMarkdown.hasRoot"
        },
        {
          "command": "hyperMarkdown.togglePin",
          "when": "hyperMarkdown.hasRoot"
        },
        {
          "command": "hyperMarkdown.createCardFromLink",
          "when": "editorLangId == hmd"
        }
      ]
    },
    "configuration": {
      "title": "HyperMarkDown",
      "properties": {
        "hyperMarkdown.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Namespace root, relative to the workspace folder. Empty means discover it from `.hmd/config.toml`, falling back to `doc/wiki`."
        },
        "hyperMarkdown.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Keep the preview and the editor scrolled to the same source line."
        },
        "hyperMarkdown.preview.embeds": {
          "type": "string",
          "enum": [
            "expanded",
            "collapsed"
          ],
          "default": "expanded",
          "description": "Whether embed cards start expanded or collapsed."
        },
        "hyperMarkdown.diagram.d2Path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `d2` executable to render diagrams with. Empty uses the `d2` bundled with this build — a pinned [hypermarkdown-toolchain](https://github.com/ewiger/hypermarkdown-toolchain) release, the same binary the documentation site is built with — falling back to `d2` on `PATH`. Set this only to test a different build of d2 deliberately: it takes precedence over the bundled one, and a path that is not an executable is reported rather than silently ignored."
        },
        "hyperMarkdown.diagnostics.scope": {
          "type": "string",
          "enum": [
            "open",
            "workspace"
          ],
          "default": "workspace",
          "markdownDescription": "Publish diagnostics for open documents only, or for every card in the index. A red link in a card nobody has opened is still a work item."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "node ../../scripts/launch-example.mjs cs-alg-sorting",
    "example:sorting": "node ../../scripts/launch-example.mjs cs-alg-sorting",
    "example:small": "node ../../scripts/launch-example.mjs small",
    "example:wiki": "node ../../scripts/launch-example.mjs wiki",
    "package": "npm run build && node ../../scripts/toolchain.mjs --dest tools/hmd-vsc-ext/toolchain && vsce package --no-dependencies"
  },
  "dependencies": {
    "@hypermarkdown/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
