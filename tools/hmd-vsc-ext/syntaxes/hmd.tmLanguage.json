{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HyperMarkDown",
  "scopeName": "source.hmd",
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#embed" },
    { "include": "#wikilink" },
    { "include": "#anchor" },
    { "include": "#cell-output" },
    { "include": "source.hmd.fences" },
    { "include": "text.html.markdown" }
  ],
  "repository": {
    "cell-output": {
      "comment": "The markers around the output a cell wrote: <!-- hql:output id=books hash=… status=ok --> and <!-- /hql:output -->.",
      "name": "comment.block.html meta.cell-output.marker.hmd",
      "match": "^\\s*(<!--)\\s*(/?hql:output)\\b([^>]*?)\\s*(-->)\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.html" },
        "2": { "name": "keyword.other.cell-output.hmd" },
        "3": {
          "patterns": [
            {
              "match": "([A-Za-z][\\w-]*)(=)(\\S+)",
              "captures": {
                "1": { "name": "entity.other.attribute-name.cell.hmd" },
                "2": { "name": "punctuation.separator.key-value.cell.hmd" },
                "3": { "name": "string.unquoted.attribute-value.cell.hmd" }
              }
            }
          ]
        },
        "4": { "name": "punctuation.definition.comment.html" }
      }
    },
    "frontmatter": {
      "comment": "A --- fence at offset 0 only (HMD-0001, Grammar).",
      "begin": "\\A---\\s*$",
      "end": "^---\\s*$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.frontmatter.begin.hmd" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.frontmatter.end.hmd" }
      },
      "name": "meta.embedded.block.yaml",
      "patterns": [{ "include": "source.yaml" }]
    },
    "embed": {
      "comment": "![[target#fragment|display]]",
      "name": "meta.embed.wiki.hmd",
      "match": "(!\\[\\[)([^\\[\\]\\n|#]*)(?:(#\\^?)([^\\[\\]\\n|]*))?(?:(\\|)([^\\[\\]\\n]*))?(\\]\\])",
      "captures": {
        "1": { "name": "punctuation.definition.link.wiki.hmd" },
        "2": { "name": "entity.name.reference.hmd" },
        "3": { "name": "punctuation.definition.link.wiki.hmd" },
        "4": { "name": "entity.other.attribute-name.fragment.hmd" },
        "5": { "name": "punctuation.definition.link.wiki.hmd" },
        "6": { "name": "string.other.link.title.hmd" },
        "7": { "name": "punctuation.definition.link.wiki.hmd" }
      }
    },
    "wikilink": {
      "comment": "[[target#fragment|display]]",
      "name": "meta.link.wiki.hmd",
      "match": "(\\[\\[)([^\\[\\]\\n|#]*)(?:(#\\^?)([^\\[\\]\\n|]*))?(?:(\\|)([^\\[\\]\\n]*))?(\\]\\])",
      "captures": {
        "1": { "name": "punctuation.definition.link.wiki.hmd" },
        "2": { "name": "entity.name.reference.hmd" },
        "3": { "name": "punctuation.definition.link.wiki.hmd" },
        "4": { "name": "entity.other.attribute-name.fragment.hmd" },
        "5": { "name": "punctuation.definition.link.wiki.hmd" },
        "6": { "name": "string.other.link.title.hmd" },
        "7": { "name": "punctuation.definition.link.wiki.hmd" }
      }
    },
    "anchor": {
      "comment": "A trailing ^block-id (HMD-0001, Grammar).",
      "match": "[ \\t]+(\\^)([A-Za-z0-9][A-Za-z0-9_-]{0,63})[ \\t]*$",
      "captures": {
        "1": { "name": "punctuation.definition.label.hmd" },
        "2": { "name": "entity.name.label.hmd" }
      }
    }
  }
}
