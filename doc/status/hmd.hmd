work
| filter(r => r.kind == "open")
| map(r => { "Status": r.state.unwrap_or(""), "Work": r.text, "Notes": r.notes.unwrap_or(""), "Tags": r.tags | join(", "), "References": r.refs.unwrap_or("—") })
| Table(columns = ["Status", "Work", "Notes", "Tags", "References"])
| format(as = Markdown)
