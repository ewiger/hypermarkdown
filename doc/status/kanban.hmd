# Kanban board

Every issue under [`doc/issues/`](../issues/), read from its file: the lane its
`**Column**:` line names, or `archive` for a file under
[`doc/issues/archive/`](../issues/archive/). A column with a trailing note
reads as its first word. Within a lane, issues run newest first; the priority
order lives only in [`kanban.yaml`](../issues/kanban.yaml), which a card
cannot read. A card is archived as soon as it is done, so the `done` lane is
empty here while `kanban.yaml`'s `done` column lists the archive.

This is a generated view, not a tracker: refresh it with the command in
[the status README](README.md), and never edit an output by hand.

```hql#eval id=issues hidden
import regex

// The text after `**Column**:` on the issue's column line.
fn column_of(body: String) : String =
    regex.find(body, "(?m)^\\*\\*Column\\*\\*:[^\\n]*")
    | map(s => regex.replace_first(s, "^\\*\\*Column\\*\\*: *", ""))
    | unwrap_or("unknown")

// The lane a column names: its first word.
fn lane_of(column: String) : String =
    regex.find(column, "^[a-z]+").unwrap_or("unknown")

// A title made safe for a table cell. A pipe inside a code span cannot be
// escaped there, since the code span would show the backslash (issue 0006),
// so such a span is written as raw `<code>` with the pipe as `&#124;`.
fn cell_safe(title: String) : String =
    regex.replace_all(title, "`([^`|]*)\\|([^`]*)`", "<code>$1&#124;$2</code>")

// An issue as the board shows it: its number, its title and its lane.
type Issue { id : String, title : String, lane : String }

cards
| filter(c => (c.path.starts_with("issues/0") or c.path.starts_with("issues/archive/0"))
    and not c.path.ends_with(".prompt.md"))
| sort(by = (a, b) => compare(regex.find(b.path, "[0-9]{4}").unwrap_or(b.path),
                              regex.find(a.path, "[0-9]{4}").unwrap_or(a.path)))
| map(c => Issue(
    id = regex.find(c.path, "[0-9]{4}").unwrap_or(c.name),
    title = cell_safe(regex.replace_first(c.title, "^[0-9]{4} — *", "")),
    lane = "archive" given c.path.starts_with("issues/archive/") otherwise lane_of(column_of(c.body)),
  ))
```

## Lanes

The number of issues in each lane. The four columns of the board come first,
then the archive.

```hql#eval
["backlog", "todo", "doing", "done", "archive"]
| map(l => { lane: l, issues: issues | filter(i => i.lane == l) | size })
| Table(columns = ["lane", "issues"])
| format(as = Markdown)
```
<!-- hql:output hash=89aeb803630e status=ok -->
| lane    | issues |
| ------- | ------ |
| backlog | 5      |
| todo    | 8      |
| doing   | 0      |
| done    | 0      |
| archive | 16     |
<!-- /hql:output -->

## Board

The open issues, one column per lane. An issue leaves the board when its file
moves to the archive.

```hql#eval
// The issues of one lane, each as its id and title.
fn lane(name: String) : Seq<String> =
    issues | filter(i => i.lane == name) | map(i => i.id + " " + i.title)

// The entry at a rank in a lane, or empty below its last issue.
fn at(xs: Seq<String>, rank: Int) : String = xs[rank:rank + 1] | first | unwrap_or("")

backlog = lane("backlog")
todo = lane("todo")
doing = lane("doing")
done = lane("done")
depth = max([backlog, todo, doing, done] | map(xs => xs | size)).unwrap_or(0)

range(0, depth)
| map(r => { backlog: at(backlog, r), todo: at(todo, r), doing: at(doing, r), done: at(done, r) })
| Table(columns = ["backlog", "todo", "doing", "done"])
| format(as = Markdown)
```
