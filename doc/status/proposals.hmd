# Proposals

Every proposal under [`doc/proposals/`](../proposals/README.md), read from its
`README.md`: the number, the title, the status, and the trackers that cite it.
The status is the first word of the `**Status**:` line; one outside the list in
[the template](../proposals/TEMPLATE.md) (`drafted`, `accepted`, `rejected`,
`withdrawn`, `superseded`) shows as `invalid`. A proposal carries no
implementation state of its own: how far its code has got is in the trackers
listed beside it, which are every tracker under `doc/status/` that names the
proposal, in any case. Compare that column with the Progress column of
[the proposal index](../proposals/README.md), which is written by hand.

This is a generated view, not a tracker: refresh it with the command in
[the status README](README.md), and never edit an output by hand.

```hql#eval
import regex

// The first word after `**Status**:` on the record's status line.
fn status_of(body: String) : String =
    regex.find(body, "(?m)^\\*\\*Status\\*\\*: *[a-z]+")
    | map(s => regex.replace_first(s, "^\\*\\*Status\\*\\*: *", ""))
    | unwrap_or("unknown")

// The status, or `invalid` for a value outside the template's list.
fn checked(status: String) : String =
    status given ["drafted", "accepted", "rejected", "withdrawn", "superseded"] | any(s => s == status)
    otherwise "invalid"

// The trackers: every card directly under `status/` but the README.
trackers =
    cards
    | filter(c => regex.is_match(c.path, "^status/[a-z-]+\\.md$") and c.path != "status/README.md")
    | sort(by = c => c.path)

// A list of links, or `—` for none.
fn or_dash(s: String) : String = "—" given s == "" otherwise s

// The trackers that name a proposal, as links, or `—` for none.
fn cited_by(id: String) : String =
    or_dash(trackers
        | filter(t => regex.is_match(t.body, "(?i)" + id))
        | map(t => "[" + t.name + "](" + t.name + ".md)")
        | join(", "))

// A proposal as the table shows it.
type ProposalRow { proposal : String, title : String, status : String, trackers : String }

// A proposal's row, from its id and its record.
fn row(id: String, c: Card) : ProposalRow =
    ProposalRow(
        proposal = "[" + id + "](../proposals/" + id + "/README.md)",
        title = regex.replace_first(c.title, "^HMD-[0-9]{4}: *", ""),
        status = checked(status_of(c.body)),
        trackers = cited_by(id),
    )

cards
| filter(c => regex.is_match(c.path, "^proposals/HMD-[0-9]{4}/README\\.md$"))
| sort(by = c => c.path)
| map(c => row(regex.find(c.path, "HMD-[0-9]{4}").unwrap_or(c.name), c))
| Table(columns = ["proposal", "title", "status", "trackers"])
| format(as = Markdown)
```
